# Caddy edge for the Meridian feed: automatic HTTPS, permissive CORS (one feed shared by every origin),
# and cache headers a CDN honours. Serves the builder's /data/feed_out directory as static files.
{$FEED_DOMAIN} {
	root * /data/feed_out
	encode gzip zstd

	header Access-Control-Allow-Origin "*"
	header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"

	@json path *.json
	header @json Cache-Control "public, max-age=60"

	@html path *.html
	header @html Cache-Control "public, max-age=300"

	@options method OPTIONS
	respond @options 204

	file_server
}
